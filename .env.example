# ============================================
# CONFIGURATION PHARMA-DJ
# ============================================

# --- Base de données ---
DATABASE_URL="postgresql://pharma:pharma123@localhost:5432/pharmadj?schema=public"

# --- API ---
API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development

# --- Sécurité ---
JWT_SECRET="changez-moi-en-production-avec-une-cle-de-64-caracteres-minimum"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="autre-cle-secrete-differente-pour-refresh-tokens"
REFRESH_TOKEN_EXPIRES_IN="7d"
BCRYPT_COST=12

# --- Frontend ---
VITE_API_URL=http://localhost:3000/api
VITE_APP_NAME="PharmaDJ"

# --- Pharmacie ---
PHARMACIE_NOM="Pharmacie Centrale"
PHARMACIE_NIF=""
PHARMACIE_RCCM=""
PHARMACIE_ADRESSE="Djibouti, Djibouti"
PHARMACIE_TELEPHONE="+253 21 00 00 00"
PHARMACIE_EMAIL="contact@pharmacie.dj"
DEVISE="FDJ"
TVA_DEFAUT=0

# --- Notifications ---
SMS_PROVIDER=""
SMS_API_KEY=""
WHATSAPP_API_TOKEN=""

# --- Email ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@pharmacie.dj"

# --- Sauvegardes ---
BACKUP_LOCAL_PATH="/var/backups/pharmadj"
BACKUP_S3_BUCKET=""
BACKUP_S3_REGION=""
BACKUP_S3_ACCESS_KEY=""
BACKUP_S3_SECRET_KEY=""

# --- Mode hors ligne ---
OFFLINE_MODE_ENABLED=true
SYNC_INTERVAL_MS=30000
